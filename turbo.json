{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "cf-typegen": {
      "inputs": ["wrangler.jsonc"],
      "outputs": ["worker-configuration.d.ts"]
    },
    "lint": {
      "dependsOn": ["^build", "cf-typegen"]
    },
    "typecheck": {
      "dependsOn": ["^build", "cf-typegen"]
    },
    "test": {
      "dependsOn": ["^build", "cf-typegen"]
    }
  }
}
