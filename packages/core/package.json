{
  "name": "@pockey/core",
  "version": "0.0.0",
  "description": "Headless Pockey client: auth, sessions and embedded wallets over the Pockey API.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@pockey/types": "workspace:*",
    "@simplewebauthn/browser": "^14.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@pockey/config": "workspace:*",
    "eslint": "^9.39.0",
    "tsup": "^8.5.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sairalabs/pockey.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/sairalabs/pockey#readme",
  "bugs": {
    "url": "https://github.com/sairalabs/pockey/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
