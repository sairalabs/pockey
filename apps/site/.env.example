# Both optional. The publisher is in src/lib/site.ts, because it is on the
# legal page either way and a deploy that forgot a variable should not be able
# to publish a site without one.

# The address the site is served from, used for canonical links, the sitemap
# and the share card. Defaults to https://pockey.xyz.
NEXT_PUBLIC_SITE_URL=https://pockey.xyz

# Where a question, a legal request or a privacy request should go.
NEXT_PUBLIC_CONTACT_EMAIL=hello@saira.xyz
