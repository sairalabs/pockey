# The site reads its legal identity from the environment, because this
# repository is public and a publisher's address does not belong in it.
# Set these in the hosting provider before the site goes live.

NEXT_PUBLIC_SITE_URL=https://pockey.xyz
NEXT_PUBLIC_CONTACT_EMAIL=hello@saira.xyz

# Required before the site is public. French law asks a published site to
# name its publisher, and each of these appears on /legal/notice, where an
# empty one reads "to be set" in plain sight.

# The company or person publishing the site.
NEXT_PUBLIC_LEGAL_PUBLISHER=
# Its legal form, and its capital if it has one.
NEXT_PUBLIC_LEGAL_STATUS=
# The registered address, on one line.
NEXT_PUBLIC_LEGAL_ADDRESS=
# The registration number, and the VAT number if there is one.
NEXT_PUBLIC_LEGAL_REGISTRATION=
# The person responsible for what is published.
NEXT_PUBLIC_LEGAL_DIRECTOR=
# Where a legal or privacy request should go. Falls back to the contact above.
NEXT_PUBLIC_LEGAL_EMAIL=
