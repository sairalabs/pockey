# Copy to .dev.vars for local development. Never commit .dev.vars.
# Production values live in Wrangler secrets (`wrangler secret put NAME`).

# Required. Signs Better Auth cookies and derives the access token key (HKDF).
BETTER_AUTH_SECRET=replace-with-openssl-rand-hex-32
# Key provider. `mock` (default) is an in-memory Turnkey emulator: wallets are lost
# when wrangler restarts. `turnkey` uses your Turnkey organization (keeps wallets,
# sends real OTP emails). Production refuses `mock`.
# KEY_PROVIDER=turnkey
# console prints OTP codes in the wrangler log. Use resend in production.
MAILER=console

# Origin of the dashboard (T5.1). Only origin allowed with credentials on /admin/*.
# DASHBOARD_ORIGIN=http://localhost:3800
# Dashboard sign-in with GitHub. Callback: <API_BASE_URL>/admin/auth/callback/github.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# RESEND_API_KEY=
# MAIL_FROM=Pockey <auth@pockey.xyz>
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=
# APPLE_APP_BUNDLE_IDENTIFIER=
# RPC_URLS={"8453":"https://base-mainnet.g.alchemy.com/v2/KEY","solana:devnet":"https://devnet.helius-rpc.com/?api-key=KEY"}
# Turnkey parent organization and its API key (P-256, hex). Required with KEY_PROVIDER=turnkey.
# TURNKEY_ORG_ID=
# TURNKEY_API_PUBLIC_KEY=
# TURNKEY_API_PRIVATE_KEY=
# Optional separate key for session signers and fee payer wallets (defaults to the API key).
# TURNKEY_SIGNER_PUBLIC_KEY=
# TURNKEY_SIGNER_PRIVATE_KEY=
# Gas sponsoring. mock payments sign webhooks with a public test secret and static
# prices are fixed (ETH 3000, SOL 150, POL 0.5 USD): production needs stripe and coingecko.
# PAYMENTS=mock
# PRICE_FEED=static
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Usage based billing (section 11, T5.4): the metered price and the event_name of
# the billing meter behind it. Required in production. Without them the billing
# portal answers 400 and the nightly meter cron reports nothing.
# STRIPE_ACTIVE_WALLET_PRICE_ID=
# STRIPE_ACTIVE_WALLET_METER_NAME=active_wallets
# Without it, EVM sponsored sends answer 400 (Solana sponsoring still works).
# PIMLICO_API_KEY=
# Rate limit overrides (T5.5), requests per minute per scope. Defaults live in
# src/rate-limit/limits.ts: app 600, user 120, authApp 30, authIdentity 5,
# serverKey 300, sponsoredSend 10. A value of 0 disables that scope.
# RATE_LIMITS={"authIdentity":10}
